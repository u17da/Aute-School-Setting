{
  "name": "manapoke-school-settings-automation",
  "version": "1.1.0",
  "description": "まなびポケット 9.2 学校設定 ブラウザ自動化 PoC",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "start": "ts-node -T src/index.ts",
    "generate-schema": "ts-node -T src/config/generateSchema.ts",
    "test": "ts-node -T test/run_all_tests.ts --category=A",
    "test:default": "ts-node -T test/run_all_tests.ts --category=A",
    "test:extended": "ts-node -T test/run_all_tests.ts --category=B",
    "test:full": "ts-node -T test/run_all_tests.ts --category=full",
    "test:manifest": "ts-node -T test/run_all_tests.ts --manifest",
    "test:login-flow": "ts-node test/login_verification_flow.test.ts",
    "test:phase2a": "ts-node -T test/phase2a.test.ts",
    "test:phase2b": "ts-node -T test/phase2b.test.ts",
    "test:phase3": "ts-node -T test/phase3.test.ts",
    "test:console": "ts-node -T test/console.test.ts",
    "test:phase5b1": "ts-node -T test/phase5b1_profile_editor.test.ts",
    "test:phase5b2": "ts-node -T test/phase5b2_manifest_and_outcomes.test.ts",
    "test:phase5b3": "ts-node -T test/phase5b3_production_apply.test.ts",
    "test:phase5b4": "ts-node -T test/phase5b4_mock_write_e2e.test.ts",
    "test:phase6a": "ts-node -T test/phase6a_workflow.test.ts",
    "test:gui-smoke": "ts-node -T test/phase5b4_gui_mock_smoke.test.ts",
    "test:stress": "ts-node -T test/stress_mock_400.test.ts",
    "test:e2e": "ts-node -T test/platform/platform_e2e_scenario.test.ts",
    "console": "ts-node -T src/console/server.ts",
    "grade-class": "ts-node -T scripts/register_school_grades_classes.ts",
    "package:win": "ts-node -T scripts/package-win.ts",
    "test:portable": "ts-node -T test/portable_package.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
