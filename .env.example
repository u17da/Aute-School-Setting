# まなびポケット 認証・実行環境設定

# 認証モード (A: 学校コード+ID/PW, B: 外部IdP連携/MFA)
AUTH_MODE=A

# ログイン先ベースURL
MANAPOKE_BASE_URL=https://ed-cl.com

# AUTH_MODE=A用 認証情報
MANAPOKE_SCHOOL_CODE=XXXXXXXX
MANAPOKE_USER_ID=school_admin
MANAPOKE_PASSWORD=your_password_here

# 外部IdP認証 (AUTH_MODE=B用) タイムアウト（ミリ秒）
EXTERNAL_IDP_TIMEOUT_MS=300000

# 実行制御フラグ
# true の場合は変更・保存を行わず差分とリスク計画を表示
DRY_RUN=true

# 破壊的変更（タイムライン・全体チャンネル・保護者チャンネルのON→OFFによる予約投稿削除）の許可
# true に明示しない限りブロック
ALLOW_DESTRUCTIVE_CHANGES=false

# ブラウザ起動設定
HEADLESS=false
SLOW_MO_MS=100
DEFAULT_TIMEOUT_MS=30000
